---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { id: 'hero', label: t('nav.home') },
  { id: 'about', label: t('nav.about') },
  { id: 'members', label: t('nav.members') },
  { id: 'next-gigs', label: t('nav.nextGigs') },
  { id: 'events', label: t('nav.events') },
  { id: 'contact', label: t('nav.contact') },
];
---

<nav class="nav-menu">
  {navItems.map(item => (
    <a href={`#${item.id}`} class="nav-link" data-section={item.id}>
      {item.label}
    </a>
  ))}
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sections = ['hero', 'about', 'members', 'next-gigs', 'events', 'contact'];
    const navLinks = document.querySelectorAll('.nav-link');

    function updateActiveLink() {
      const scrollPosition = window.scrollY + window.innerHeight / 3;

      let currentSection = 'hero';

      sections.forEach(sectionId => {
        const section = document.getElementById(sectionId);
        if (section && section.offsetTop <= scrollPosition) {
          currentSection = sectionId;
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('data-section') === currentSection) {
          link.classList.add('active');
        }
      });
    }

    window.addEventListener('scroll', updateActiveLink);
    updateActiveLink();
  });
</script>

<style>
  .nav-menu {
    position: fixed;
    top: 2rem;
    left: 2rem;
    z-index: 1000;
    display: flex;
    gap: 0.5rem;
    background-color: rgba(0, 45, 66, 0.9);
    padding: 0.5rem;
    border-radius: 50px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(195, 248, 140, 0.2);
  }

  .nav-link {
    background-color: transparent;
    color: var(--blanco);
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.3s ease;
    font-size: 0.9rem;
    text-decoration: none;
    display: inline-block;
  }

  .nav-link:hover {
    background-color: rgba(195, 248, 140, 0.1);
    color: var(--verde);
  }

  .nav-link.active {
    background-color: var(--verde);
    color: var(--azul);
  }

  @media (max-width: 768px) {
    .nav-menu {
      top: 1rem;
      left: 1rem;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.25rem;
    }

    .nav-link {
      padding: 0.4rem 0.8rem;
      font-size: 0.8rem;
    }
  }
</style>
