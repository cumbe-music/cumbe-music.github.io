---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { id: 'hero', label: t('nav.home') },
  { id: 'about', label: t('nav.about') },
  { id: 'members', label: t('nav.members') },
  { id: 'next-gigs', label: t('nav.nextGigs') },
  { id: 'events', label: t('nav.events') },
  { id: 'contact', label: t('nav.contact') },
];
---

<nav class="nav-menu" id="nav-menu">
  <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu">
    <span class="hamburger"></span>
  </button>
  <div class="nav-links" id="nav-links">
    {navItems.map(item => (
      <a href={`#${item.id}`} class="nav-link" data-section={item.id}>
        {item.label}
      </a>
    ))}
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sections = ['hero', 'about', 'members', 'next-gigs', 'events', 'contact'];
    const navLinks = document.querySelectorAll('.nav-link');
    const menuToggle = document.getElementById('menu-toggle');
    const navLinksContainer = document.getElementById('nav-links');
    const navMenu = document.getElementById('nav-menu');

    // Toggle menu on mobile
    menuToggle?.addEventListener('click', () => {
      navMenu?.classList.toggle('open');
    });

    // Close menu when clicking a link
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        navMenu?.classList.remove('open');
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (navMenu && !navMenu.contains(e.target as Node)) {
        navMenu.classList.remove('open');
      }
    });

    function updateActiveLink() {
      const scrollPosition = window.scrollY + window.innerHeight / 3;

      let currentSection = 'hero';

      sections.forEach(sectionId => {
        const section = document.getElementById(sectionId);
        if (section && section.offsetTop <= scrollPosition) {
          currentSection = sectionId;
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('data-section') === currentSection) {
          link.classList.add('active');
        }
      });
    }

    window.addEventListener('scroll', updateActiveLink);
    updateActiveLink();
  });
</script>

<style>
  .nav-menu {
    position: fixed;
    top: 2rem;
    left: 2rem;
    z-index: 1000;
    display: flex;
    gap: 0.5rem;
    background-color: rgba(0, 45, 66, 0.9);
    padding: 0.5rem;
    border-radius: 50px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(195, 248, 140, 0.2);
  }

  .nav-link {
    background-color: transparent;
    color: var(--blanco);
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.3s ease;
    font-size: 0.9rem;
    text-decoration: none;
    display: inline-block;
  }

  .nav-link:hover {
    background-color: rgba(195, 248, 140, 0.1);
    color: var(--verde);
  }

  .nav-link.active {
    background-color: var(--verde);
    color: var(--azul);
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1001;
  }

  .hamburger {
    display: block;
    width: 25px;
    height: 2px;
    background-color: var(--verde);
    position: relative;
    transition: all 0.3s ease;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    width: 25px;
    height: 2px;
    background-color: var(--verde);
    transition: all 0.3s ease;
  }

  .hamburger::before {
    top: -8px;
  }

  .hamburger::after {
    bottom: -8px;
  }

  .nav-menu.open .hamburger {
    background-color: transparent;
  }

  .nav-menu.open .hamburger::before {
    transform: rotate(45deg);
    top: 0;
  }

  .nav-menu.open .hamburger::after {
    transform: rotate(-45deg);
    bottom: 0;
  }

  @media (max-width: 768px) {
    .nav-menu {
      top: 1rem;
      left: 1rem;
      flex-direction: column;
      padding: 0.5rem;
      gap: 0;
    }

    .menu-toggle {
      display: block;
    }

    .nav-links {
      display: none;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1px solid rgba(195, 248, 140, 0.2);
    }

    .nav-menu.open .nav-links {
      display: flex;
    }

    .nav-link {
      padding: 0.6rem 1rem;
      font-size: 0.85rem;
      width: 100%;
      text-align: left;
    }
  }
</style>
