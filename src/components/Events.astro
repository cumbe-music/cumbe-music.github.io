---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';
import ScrollArrow from './ScrollArrow.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="events" class="section">
  <div class="container">
    <h2 class="section-title">{t('events.title')}</h2>
    <div class="events-container">
      <div class="event-card">
        <div class="event-image-container">
          <img src="/images/events/fete-de-la-musique-2026.png" alt="Fête de la Musique Berlin" class="event-image" />
        </div>
        <div class="event-content">
          <h3 class="event-name">{t('events.event4.name')}</h3>
          <p class="event-date">{t('events.event4.date')}</p>
          <p class="event-description">{t('events.event4.description')}</p>
          <p class="event-location">{t('events.event4.location')}</p>
        </div>
      </div>
      <a href="https://www.instagram.com/p/DV8HqGZjcFv/" target="_blank" rel="noopener noreferrer" class="event-card event-link">
        <div class="event-image-container">
          <img src="/images/events/un-llamado-al-corazon.png" alt="Un Llamado al Corazón" class="event-image" />
        </div>
        <div class="event-content">
          <h3 class="event-name">{t('events.event3.name')}</h3>
          <p class="event-date">{t('events.event3.date')}</p>
          <p class="event-description">{t('events.event3.description')}</p>
          <p class="event-location">{t('events.event3.location')}</p>
        </div>
      </a>
      <a href="https://lasurrealfilmfestival.com/la-sur-real-colombia/" target="_blank" rel="noopener noreferrer" class="event-card event-link">
        <div class="event-image-container">
          <img src="/images/events/la-sur-real.png" alt="La Sur Real Film Festival" class="event-image" />
        </div>
        <div class="event-content">
          <h3 class="event-name">{t('events.event2.name')}</h3>
          <p class="event-date">{t('events.event2.date')}</p>
          <p class="event-description">{t('events.event2.description')}</p>
          <p class="event-location">{t('events.event2.location')}</p>
        </div>
      </a>
      <a href="https://www.mahalla.berlin/event/sweat/" target="_blank" rel="noopener noreferrer" class="event-card event-link">
        <div class="event-image-container">
          <img src="/images/events/sweat.jpg" alt="SWEAT Event" class="event-image" />
        </div>
        <div class="event-content">
          <h3 class="event-name">{t('events.event1.name')}</h3>
          <p class="event-date">{t('events.event1.date')}</p>
          <p class="event-description">{t('events.event1.description')}</p>
          <p class="event-location">{t('events.event1.location')}</p>
        </div>
      </a>
    </div>
    <ScrollArrow targetSection="contact" />
  </div>
</section>

<style>
  .events-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
  }

  .event-card {
    background: linear-gradient(135deg, rgba(195, 248, 140, 0.05) 0%, rgba(217, 101, 24, 0.05) 100%);
    border-radius: 20px;
    border: 1px solid rgba(195, 248, 140, 0.2);
    transition: all 0.3s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding-top: 1.5rem;
  }

  .event-link {
    text-decoration: none;
    color: inherit;
  }

  .event-card:hover {
    transform: translateY(-5px);
    border-color: var(--naranja);
    box-shadow: 0 15px 40px rgba(217, 101, 24, 0.2);
  }

  .event-image-container {
    width: calc(100% - 3rem);
    height: 300px;
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, rgba(0, 45, 66, 0.5) 0%, rgba(0, 45, 66, 0.8) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 1.5rem;
    border-radius: 15px;
  }

  .event-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .event-card:hover .event-image {
    transform: scale(1.05);
  }

  .event-content {
    padding: 2rem;
  }

  .event-name {
    font-family: 'Montserrat Alternates', sans-serif;
    color: var(--verde);
    font-size: 1.8rem;
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .event-date {
    color: var(--naranja);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .event-description {
    color: var(--blanco);
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .event-location {
    color: var(--verde);
    font-weight: 500;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .events-container {
      grid-template-columns: 1fr;
    }

    .event-image-container {
      height: 250px;
    }
  }
</style>
