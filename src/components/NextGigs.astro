---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';
import ScrollArrow from './ScrollArrow.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Toggle this to switch between showing upcoming events or "coming soon"
const hasUpcomingEvents = true;
---

<section id="next-gigs" class="section">
  <div class="container">
    <h2 class="section-title">{t('nextGigs.title')}</h2>

    {hasUpcomingEvents ? (
      <!-- ACTIVE EVENTS MODE: Display upcoming events -->
      <div class="events-container">
        <a href="https://www.instagram.com/p/DFf1CvwI_Ip/" target="_blank" rel="noopener noreferrer" class="event-card event-link">
          <div class="event-image-container">
            <img src="/images/events/un-llamado-al-corazon.png" alt="Un Llamado al Corazón" class="event-image" />
          </div>
          <div class="event-content">
            <h3 class="event-name">{t('nextGigs.event1.name')}</h3>
            <p class="event-date">{t('nextGigs.event1.date')}</p>
            <p class="event-description">{t('nextGigs.event1.description')}</p>
            <p class="event-location">{t('nextGigs.event1.location')}</p>
          </div>
        </a>
        <!-- Add more events here as needed -->
      </div>
    ) : (
      <!-- COMING SOON MODE: Display placeholder when no upcoming events -->
      <div class="coming-soon-container">
        <div class="coming-soon-card">
          <div class="coming-soon-content">
            <h3 class="coming-soon-title">{t('nextGigs.comingSoon')}</h3>
            <p class="coming-soon-text">{t('nextGigs.stayTuned')}</p>
            <div class="dots">
              <span class="dot"></span>
              <span class="dot"></span>
              <span class="dot"></span>
            </div>
          </div>
        </div>
      </div>
    )}

    <ScrollArrow targetSection="events" />
  </div>
</section>

<style>
  /* Event Card Styles (for active events) */
  .events-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    justify-items: center;
  }

  .event-card {
    background: linear-gradient(135deg, rgba(195, 248, 140, 0.05) 0%, rgba(217, 101, 24, 0.05) 100%);
    border-radius: 20px;
    border: 1px solid rgba(195, 248, 140, 0.2);
    transition: all 0.3s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding-top: 1.5rem;
    max-width: 600px;
    width: 100%;
  }

  .event-link {
    text-decoration: none;
    color: inherit;
  }

  .event-card:hover {
    transform: translateY(-5px);
    border-color: var(--naranja);
    box-shadow: 0 15px 40px rgba(217, 101, 24, 0.2);
  }

  .event-image-container {
    width: calc(100% - 3rem);
    height: 300px;
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, rgba(0, 45, 66, 0.5) 0%, rgba(0, 45, 66, 0.8) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 1.5rem;
    border-radius: 15px;
  }

  .event-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .event-card:hover .event-image {
    transform: scale(1.05);
  }

  .event-content {
    padding: 2rem;
  }

  .event-name {
    font-family: 'Montserrat Alternates', sans-serif;
    color: var(--verde);
    font-size: 1.8rem;
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .event-date {
    color: var(--naranja);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .event-description {
    color: var(--blanco);
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .event-location {
    color: var(--verde);
    font-weight: 500;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  /* Coming Soon Styles (for when no upcoming events) */
  .coming-soon-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 400px;
  }

  .coming-soon-card {
    background: linear-gradient(135deg, rgba(195, 248, 140, 0.05) 0%, rgba(217, 101, 24, 0.05) 100%);
    padding: 4rem 3rem;
    border-radius: 30px;
    border: 2px dashed rgba(195, 248, 140, 0.3);
    text-align: center;
    max-width: 600px;
    width: 100%;
    transition: all 0.3s ease;
  }

  .coming-soon-card:hover {
    border-color: var(--verde);
    box-shadow: 0 20px 50px rgba(195, 248, 140, 0.2);
    transform: translateY(-5px);
  }

  .coming-soon-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .coming-soon-title {
    font-family: 'Montserrat Alternates', sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--verde);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .coming-soon-text {
    color: var(--blanco);
    font-size: 1.2rem;
    font-weight: 300;
    opacity: 0.9;
    margin: 0;
  }

  .dots {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .dot {
    width: 12px;
    height: 12px;
    background-color: var(--verde);
    border-radius: 50%;
    animation: pulse 1.5s ease-in-out infinite;
  }

  .dot:nth-child(2) {
    animation-delay: 0.3s;
  }

  .dot:nth-child(3) {
    animation-delay: 0.6s;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.3;
      transform: scale(0.8);
    }
  }

  @media (max-width: 768px) {
    .events-container {
      grid-template-columns: 1fr;
    }

    .event-image-container {
      height: 250px;
    }

    .coming-soon-card {
      padding: 3rem 2rem;
    }
  }
</style>
